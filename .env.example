PORT=8080
NODE_ENV=development

# Server-only secrets. Never prefix credentials with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024

PINECONE_API_KEY=
# Use an index containing embeddings from this same Gemini model/dimension.
# OpenAI and Google vectors are incompatible EVEN when dimensions match.
# Use a separate Gemini index; the app never creates/deletes/resizes an index.
PINECONE_INDEX=
PINECONE_NAMESPACE=policies

# Safe default: startup does not write to Pinecone.
INGEST_ON_STARTUP=false
# KNOWLEDGE_DIRECTORY=./knowledge

# Comma-separated exact origins. No wildcard. Include your production origin.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
PROVIDER_TIMEOUT_MS=20000
REQUEST_TIMEOUT_MS=65000

# Empty uses Vite's /api proxy in dev and same-origin Express in production.
# Only public configuration belongs in VITE_ variables.
VITE_API_URL=
VITE_REQUEST_TIMEOUT_MS=70000
